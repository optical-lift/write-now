{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://write-now.opticallift.com/research/mark/relational-law-observation-packet-v1.schema.json",
  "title": "Mark Relational Law Observation Packet v1",
  "description": "Substrate-neutral observation container for preserving Mark evidence before cross-source law comparison. It records observation and relational structure but forbids universal-law assignment at this stage.",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "observation_kind",
    "discovery_lane",
    "evidence",
    "observation",
    "relational",
    "epistemic",
    "isolation"
  ],
  "properties": {
    "schema_version": {
      "const": "mark_relational_law_observation_packet_v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^RLOP-[0-9]{3,}$"
    },
    "observation_kind": {
      "type": "string",
      "minLength": 1
    },
    "discovery_lane": {
      "type": "object",
      "required": [
        "container_id",
        "container_kind",
        "experiment_id",
        "local_label"
      ],
      "properties": {
        "container_id": {
          "type": "string",
          "minLength": 1
        },
        "container_kind": {
          "type": "string",
          "minLength": 1
        },
        "experiment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "status",
        "source_refs",
        "observation_summary",
        "quantitative_anchors"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "negative",
            "rejected",
            "diagnostic",
            "unresolved",
            "insufficient_contrast"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "repository",
              "ref",
              "path"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "locator": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "observation_summary": {
          "type": "string",
          "minLength": 1
        },
        "quantitative_anchors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "substrate",
        "observed_units",
        "context",
        "before_state",
        "event_or_contrast",
        "after_state",
        "outcome",
        "representation_scope",
        "surface_features_used",
        "surface_features_excluded"
      ],
      "properties": {
        "substrate": {
          "type": "string",
          "minLength": 1
        },
        "observed_units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "before_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_or_contrast": {
          "type": "string",
          "minLength": 1
        },
        "after_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "representation_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surface_features_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surface_features_excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "relational": {
      "type": "object",
      "required": [
        "participants",
        "relations_before",
        "relations_changed",
        "relations_after",
        "preserved_invariants",
        "changed_properties",
        "dependencies",
        "role_constraints",
        "boundary_conditions",
        "sequence_properties",
        "unknowns"
      ],
      "properties": {
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "local_id",
              "role_description",
              "identity_persistence"
            ],
            "properties": {
              "local_id": {
                "type": "string"
              },
              "role_description": {
                "type": "string"
              },
              "identity_persistence": {
                "enum": [
                  "preserved",
                  "changed",
                  "not_applicable",
                  "unknown"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "relations_before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relations_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relations_after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sequence_properties": {
          "type": "object",
          "required": [
            "order_sensitive",
            "repetition_behavior",
            "composition_behavior",
            "reversibility"
          ],
          "properties": {
            "order_sensitive": {
              "enum": [
                "yes",
                "no",
                "unresolved",
                "not_tested",
                "not_applicable"
              ]
            },
            "repetition_behavior": {
              "type": "string"
            },
            "composition_behavior": {
              "type": "string"
            },
            "reversibility": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "epistemic": {
      "type": "object",
      "required": [
        "strength",
        "supported_statement",
        "prohibited_inferences",
        "unresolved"
      ],
      "properties": {
        "strength": {
          "enum": [
            "strong",
            "moderate",
            "weak",
            "negative_constraint",
            "diagnostic"
          ]
        },
        "supported_statement": {
          "type": "string",
          "minLength": 1
        },
        "prohibited_inferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": [
        "source_local_only",
        "cross_source_matching_performed",
        "external_semantic_labels_used",
        "universal_law_label",
        "candidate_equivalences"
      ],
      "properties": {
        "source_local_only": {
          "type": "boolean"
        },
        "cross_source_matching_performed": {
          "const": false
        },
        "external_semantic_labels_used": {
          "type": "array",
          "maxItems": 0
        },
        "universal_law_label": {
          "type": "null"
        },
        "candidate_equivalences": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "extension_fields": {
      "type": "object",
      "description": "Open expansion socket. New evidence-bearing dimensions may be added here without forcing them into a closed ontology.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
