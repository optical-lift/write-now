{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Absence-State Model v1 Source-Law Entry",
  "type": "object",
  "required": [
    "entry_id",
    "source_id",
    "law_signature_id",
    "law_signature_version",
    "instantiation_evidence",
    "opportunity_status",
    "observability_status",
    "compatibility_status",
    "coverage_status",
    "derived_state",
    "evidence_refs",
    "rationale",
    "evidence_ceiling"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^ASM-[0-9]{3,}$"
    },
    "source_id": {
      "type": "string"
    },
    "law_signature_id": {
      "type": "string"
    },
    "law_signature_version": {
      "type": "string"
    },
    "instantiation_evidence": {
      "enum": [
        "OBSERVED_PRESENT",
        "NOT_OBSERVED",
        "UNKNOWN"
      ]
    },
    "opportunity_status": {
      "enum": [
        "DEMONSTRATED",
        "POSSIBLE",
        "NONE",
        "OUTSIDE_EXPOSED_REGION",
        "UNKNOWN"
      ]
    },
    "observability_status": {
      "enum": [
        "ADEQUATE",
        "UNMEASURED",
        "NOT_PRESERVED",
        "INADEQUATE",
        "UNKNOWN"
      ]
    },
    "compatibility_status": {
      "enum": [
        "COMPATIBLE",
        "PROHIBITED",
        "STRUCTURALLY_INCOMPATIBLE",
        "UNKNOWN"
      ]
    },
    "coverage_status": {
      "enum": [
        "ADEQUATE",
        "PARTIAL",
        "NOT_SAMPLED",
        "UNKNOWN"
      ]
    },
    "derived_state": {
      "enum": [
        "PRESENT",
        "OPPORTUNITY_PRESENT_PROHIBITED",
        "COMPATIBLE_UNUSED",
        "NOT_PRESERVED",
        "OUTSIDE_EXPOSED_REGION",
        "NOT_YET_OBSERVED",
        "STRUCTURALLY_INCOMPATIBLE",
        "MEASUREMENT_UNRESOLVED",
        "UNKNOWN_ABSENCE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ceiling": {
      "type": "string"
    },
    "prior_entry_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "universal_absence_claim": {
      "const": false
    }
  },
  "additionalProperties": false
}
